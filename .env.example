# Port Configuration (optional - defaults shown)
# NOTE: these ports are deliberately distinct from the fullstack-langgraph-nextjs-agent
PORT=3100

# DEV stack (`docker compose up -d`) — disposable data.
POSTGRES_PORT=5544
S3_API_PORT=9100
S3_CONSOLE_PORT=9101

# PRODUCTION stack (`docker compose --profile full up`) — real financial records, on its own
# containers and its own volumes so a dev teardown cannot reach them.
POSTGRES_PROD_PORT=5546
S3_PROD_API_PORT=9102
S3_PROD_CONSOLE_PORT=9103

# Application URL (required for OAuth redirects in production)
# Development: defaults to http://localhost:3000 if not set
# Production: REQUIRED - set to your public URL (e.g., https://myapp.com)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Base URL the BROWSER uses for every agent API call — config, threads, history, chat and stream.
# Leave unset: it falls back to the relative `/api/agent`, which always targets whatever origin
# served the page, so it stays correct on any port.
#
# An absolute URL here overrides that for the WHOLE app, and a stale port then silently points one
# running app at ANOTHER app's database — e.g. a dev server on 9200 reading production on 3100.
# Only set it when the API genuinely lives on a different origin than the UI.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3100/api/agent

POSTGRES_USER=user
POSTGRES_PASSWORD=password

# The DEV database, served by `docker compose up -d` on POSTGRES_PORT.
POSTGRES_DB=mydb_dev

# No DATABASE_URL here on purpose. Compose builds its own from the values above and never reads
# one from this file, while host tooling (`pnpm dev`, `pnpm db:migrate`) reads `.env.local` first.
# Put it there, with the port written out — `${...}` is NOT expanded by dotenv, only by compose:
#
#   DATABASE_URL=postgresql://user:password@localhost:5544/mydb_dev?schema=public

# The PRODUCTION database, served by `--profile full` on POSTGRES_PROD_PORT. The containerized app
# is handed this URL by compose; it is named here only so host-side tools (pg_dump, psql) can
# reach it deliberately.
POSTGRES_PROD_DB=mydb
# API KEYS ONLY. Which provider and model Cameron uses is chosen in the app (Settings)
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# The "OpenAI Compatible" provider (Ollama, vLLM, LM Studio, Groq, OpenRouter, DeepSeek). Its base
# URL is entered in Settings; only the key lives here, and local endpoints usually need none.
# Left unset a dummy is sent — never your OPENAI_API_KEY, which the SDK would otherwise pick up
# and send to that URL.
# OPENAI_COMPATIBLE_API_KEY=
#
# Set true if the endpoint rejects standard JSON Schema keywords in tool definitions
# (an opaque 400 on the first tool call). Strips them the way the Google provider does.
# OPENAI_COMPATIBLE_SANITIZE_SCHEMA=false

# S3-Compatible Object Storage Configuration
# Development: MinIO (local Docker)
# Production: AWS S3, Cloudflare R2, or other S3-compatible service
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true  # Required for MinIO, false for AWS S3

# Base URL the BROWSER uses to fetch uploaded files. Leave unset here: it falls back to
# S3_ENDPOINT, which is correct whenever the server and the browser share a host.
# Set it only when the two differ — `docker compose --profile full` does, because the server
# reaches MinIO at http://minio-prod:9000 while the browser still needs http://localhost:9102.
# Compose sets it for that stack; you do not need it for host development.
# S3_PUBLIC_URL=http://localhost:9100

# For production with AWS S3, update to:
# S3_ENDPOINT=  # Leave empty for AWS S3
# S3_ACCESS_KEY_ID=your_aws_access_key
# S3_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_FORCE_PATH_STYLE=false


# Langfuse Observability (optional)
# Set LANGFUSE_ENABLED=true and provide your API keys to enable LLM tracing.
# Cloud: https://cloud.langfuse.com
# Self-hosted: point LANGFUSE_BASE_URL to your own instance (e.g. http://localhost:3030)
# See docs/OBSERVABILITY.md for setup instructions.
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
