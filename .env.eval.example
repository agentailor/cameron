# Environment for eval runs. Copy to `.env.eval` and add your key:
#
#   cp .env.eval.example .env.eval
#
# Points at the isolated eval stack in `compose.eval.yaml` (ports 5545 / 9110), NOT the dev stack
# in `compose.yaml` (5544 / 9100). Everything except the infrastructure matches what ships.
#
# `.env.eval` is gitignored — it holds an API key. This template is committed.

DATABASE_URL=postgresql://user:password@localhost:5545/cameron_eval

S3_ENDPOINT=http://localhost:9110
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

LANGFUSE_ENABLED=false

# Evals call a real model — this is the only cost of a run.
ANTHROPIC_API_KEY=
